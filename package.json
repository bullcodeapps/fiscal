{
  "name": "@bullcode/fiscal",
  "version": "0.3.0",
  "private": true,
  "description": "Brazilian fiscal documents: NFS-e Nacional emission (DPS build, XMLDSig signing, Sefin mTLS client)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nfse": {
      "import": {
        "types": "./dist/nfse/index.d.ts",
        "default": "./dist/nfse/index.js"
      },
      "require": {
        "types": "./dist/nfse/index.d.cts",
        "default": "./dist/nfse/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "nfse": [
        "./dist/nfse/index.d.cts"
      ]
    }
  },
  "files": [
    "dist",
    "nfse"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "node-forge": "^1.4.0",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "xml-crypto": "^6.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "xmllint-wasm": "5.3.0"
  }
}
