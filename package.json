{
  "name": "@bullcode/fiscal",
  "version": "0.3.4",
  "description": "Brazilian fiscal documents: NFS-e Nacional emission (DPS build, XMLDSig signing, Sefin mTLS client)",
  "keywords": [
    "nfse",
    "nfs-e",
    "nfse-nacional",
    "dps",
    "sefin",
    "danfse",
    "xmldsig",
    "nota-fiscal",
    "brazil"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bullcodeapps/fiscal.git"
  },
  "homepage": "https://github.com/bullcodeapps/fiscal/tree/main/docs",
  "bugs": "https://github.com/bullcodeapps/fiscal/issues",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.11"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nfse": {
      "import": {
        "types": "./dist/nfse/index.d.ts",
        "default": "./dist/nfse/index.js"
      },
      "require": {
        "types": "./dist/nfse/index.d.cts",
        "default": "./dist/nfse/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "nfse": [
        "./dist/nfse/index.d.cts"
      ]
    }
  },
  "files": [
    "dist",
    "nfse",
    "docs",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:docs": "tsup && node scripts/check-docs.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm check:docs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "node-forge": "^1.4.3",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "xml-crypto": "^6.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "xmllint-wasm": "5.3.0"
  }
}
